<Window x:Class="Diary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diary"
        mc:Ignorable="d"
        Title="Бедарева Софья, Сторожева Анна, 9ИС-435, ПР №5: Текстовые компоненты WPF" Height="450" Width="800">
    <Grid>
        <Button x:Name="Button_add" Content="Добавить заметку " HorizontalAlignment="Center" Margin="0,13,0,0" VerticalAlignment="Top" Width="140" Height="30"/>
        <Button x:Name="Button_show" Content="Показать все заметки " HorizontalAlignment="Center" Margin="0,48,0,0" VerticalAlignment="Top" Width="140" Height="30"/>
        <Button x:Name="Button_clear" Content="Очистить поле ввода " HorizontalAlignment="Center" Margin="0,83,0,0" VerticalAlignment="Top" Width="140" Height="30"/>
        <Button x:Name="Button_delete" Content="Удалить все заметки " HorizontalAlignment="Center" Margin="0,118,0,0" VerticalAlignment="Top" Width="140" Height="30"/>
        <Button x:Name="Button_exit" Content="Выход " HorizontalAlignment="Center" Margin="0,153,0,0" VerticalAlignment="Top" Width="140" Height="30"/>
        <TextBlock HorizontalAlignment="Left" Margin="622,319,0,0" TextWrapping="Wrap" Text="Работу выполнили: Бедарева Софья и Сторожева Анна Группа: 9ИС-435 ПР №5: Текстовые компоненты WPF Демонстрация работы с текстовыми компонентами" VerticalAlignment="Top" Height="105" Width="168"/>
        <TextBox HorizontalAlignment="Left" Margin="10,39,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="144" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,188,183,10"/>
        <Label Content="Ваша заметка:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="141" Height="24"/>

    </Grid>
</Window>
